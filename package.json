{
  "name": "cloudflare-clerk-stripe-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-build-info.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:ci": "mkdir -p artifacts && vitest run --reporter=default --reporter=json --outputFile=artifacts/test-results.json",
    "report:build": "node scripts/generate-build-report.mjs",
    "validate:deployed-sha": "node scripts/validate-deployed-sha.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@clerk/astro": "^3.0.1",
    "@clerk/backend": "^3.0.1",
    "astro": "^5.18.0",
    "stripe": "^20.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.71.0"
  }
}
